+:root {
+  /* props-states: warna keadaan. Sumber nilai ada di laporan; ubah di sini, semua halaman ikut. */
+  --brand-hover: #C1121F;      /* spesifikasi lama: --color-action-primary-hover */
+  --brand-tekan: #A00E19;      /* spesifikasi lama: --color-action-primary-active */
+  --wa-hover: #126c33;
+  --wa-tekan: #0f5a2b;
+  --ink-hover: #2e2e2e;        /* --ink sudah nyaris hitam: langkah hover naik, langkah tekan turun */
+  --ink-tekan: #000000;
+  --permukaan-hover: #f4f4f4;  /* permukaan putih bergaris */
+  --permukaan-tekan: #ebebeb;
+  --abu-hover: #e0e0e0;        /* permukaan --line */
+  --abu-tekan: #d9d9d9;
+  --lapis-hover: rgba(10,10,10,0.05);        /* tanpa latar: menumpang warna di bawahnya, termasuk zebra */
+  --lapis-tekan: rgba(10,10,10,0.10);
+  --lapis-balik-hover: rgba(255,255,255,0.14); /* tanpa latar di atas permukaan gelap */
+  --lapis-balik-tekan: rgba(255,255,255,0.22);
+  --kaca-hover: brightness(0.97);
+  --kaca-tekan: brightness(0.93);
+  --redup-hover: brightness(0.92);           /* foto, bidang warna lembut, isi warna bebas */
+  --redup-tekan: brightness(0.85);
+  --el-hover: 0 0.4rem 1.6rem rgba(0,0,0,0.14), 0 0.1rem 0.3rem rgba(0,0,0,0.08);
+  --el-tekan: 0 0.2rem 1rem rgba(0,0,0,0.08), 0 0.1rem 0.2rem rgba(0,0,0,0.06);
+  --bidang-hover: inset 0 0 0 0.1rem var(--line-kuat);
+  --bidang-tekan: inset 0 0 0 0.1rem var(--ink-2);
+  /* cincin fokus: tebal dan jarak dari spesifikasi lama */
+  --fokus-tebal: 2px;
+  --fokus-jarak: 2px;
+  --fokus-warna: #0a0a0a;
+  --fokus-warna-balik: #ffffff;
+  --fokus-halo: #ffffff;
+  /* gerak keadaan: --duration-base dan --easing-standard spesifikasi lama */
+  --durasi-keadaan: 150ms;
+  --ease-keadaan: cubic-bezier(0.2, 0, 0, 1);
+}
